preferences.md
# The .bak the tooling writes before every edit, and any dated migration copy.
# preferences.md has no git history, so those copies are the only thing standing
# between a bad edit and a rebuild from memory — they must never be committable.
preferences.md.*
.last_run
.known_spaces.json
.watched_threads.json
.pending_spaces.json
knowledge.md
decision-log.json
__pycache__/
*.pyc
.venv/
output/
.pytest_cache/
__pycache__/
.last_pulse_run
.pulse_seen.json
output/pulse*.json
